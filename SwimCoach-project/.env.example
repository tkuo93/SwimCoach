# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Use 'mongodb' hostname when running inside Docker Compose, '127.0.0.1' for local dev
MONGODB_URI=mongodb://127.0.0.1:27017/swimcoach

# Open Notebook Configuration
# Use 'open-notebook' hostname when running inside Docker Compose, 'localhost' for local dev
OPEN_NOTEBOOK_URL=http://localhost:8502
# OPEN_NOTEBOOK_MODEL=model:jxpska7gee83oupp4rtg  # Optional: auto-detected if omitted

# Open Notebook Encryption Key (required for credential storage)
# Set this in your .env file — must match what was used when credentials were configured
OPEN_NOTEBOOK_ENCRYPTION_KEY=your-secret-key-here

# OpenRouter API Key (required for workout generation)
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-key

# Open Notebook Model (used for knowledge base queries)
OPEN_NOTEBOOK_MODEL=model:cpommq6fi21btio7l5ru

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173