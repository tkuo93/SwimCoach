# SwimCoach Environment Variables
# Copy to .env and fill in your values

# ─── Core ───
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-session-secret-here

# ─── Database ───
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/swimcoach

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=https://your-app.onrender.com

# ─── OpenRouter (LLM) ───
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=poolside/laguna-m.1:free

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/api/telegram
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_BOT_USERNAME=YourBotUsername

# ─── Qdrant Vector Database ───
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ─── OpenNotebook (Local Knowledge Base) ───
OPEN_NOTEBOOK_URL=http://localhost:8502
OPEN_NOTEBOOK_API_KEY=  # If you enabled auth on OpenNotebook
SYSTEM_USER_ID=  # Your SwimCoach user ID (run sync to populate)

# ─── Embeddings ───
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
